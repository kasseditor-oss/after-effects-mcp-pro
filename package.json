{
  "name": "after-effects-mcp-pro",
  "version": "2.1.0",
  "description": "MCP server for Adobe After Effects: 60+ tools, synchronous results, live frame previews, background rendering, zero-click bridge.",
  "main": "build/index.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "start": "node build/index.js",
    "install-ae": "node scripts/install-ae.mjs",
    "icon": "powershell -ExecutionPolicy Bypass -File scripts/make-icon.ps1",
    "test": "node --test --test-force-exit test/unit.test.mjs",
    "test:live": "node test/live.test.mjs --cleanup",
    "test:live:keep": "node test/live.test.mjs",
    "test:stress": "node test/stress.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:es3": "node scripts/check-es3.mjs"
  },
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "acorn": "^8.19.0",
    "typescript": "^7.0.2"
  },
  "bin": {
    "after-effects-mcp-pro": "build/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "build",
    "bridge",
    "assets",
    "scripts",
    "README.md"
  ]
}
