 {
  "name": "preview_frame",
  "description": "Render one frame of a composition and return it as an image, so you can SEE the result and check your work. maxSize downscales (default 960px). JPEG by default (3-5x smaller than PNG).",
  "inputSchema": {
   "type": "object",
   "properties": {
    "comp": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "integer"
      }
     ]
    },
    "time": {
     "type": "number"
    },
    "maxSize": {
     "type": "integer",
     "minimum": 64,
     "maximum": 4096
    },
    "background": {
     "type": "string",
     "enum": [
      "comp",
      "transparent",
      "checker"
     ]
    },
    "format": {
     "type": "string",
     "enum": [
      "jpeg",
      "png"
     ]
    },
    "quality": {
     "type": "integer",
     "minimum": 30,
     "maximum": 100
    },
    "savePath": {
     "type": "string"
    }
   }
  },
  "annotations": {
   "readOnlyHint": true,
   "idempotentHint": true,
   "openWorldHint": false
  },
  "_meta": {
   "ui": {
    "resourceUri": "ui://after-effects/activity.html"
   }
  }
 },
 {
  "name": "preview_contact_sheet",
  "description": "Render N frames (or given times) as ONE labelled grid image to check an animation over time. Details: ae://docs/preview_contact_sheet",
  "inputSchema": {
   "type": "object",
   "properties": {
    "comp": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "integer"
      }
     ]
    },
    "frames": {
     "type": "integer",
     "minimum": 2,
     "maximum": 12
    },
    "times": {
     "type": "array",
     "items": {
      "type": "number"
     },
     "maxItems": 12
    },
    "maxSize": {
     "type": "integer",
     "minimum": 64,
     "maximum": 2048
    },
    "sheetMaxSize": {
     "type": "integer",
     "minimum": 256,
     "maximum": 8192
    },
    "background": {
     "type": "string",
     "enum": [
      "comp",
      "transparent",
      "checker"
     ]
    },
    "layout": {
     "type": "string",
     "enum": [
      "grid",
      "separate"
     ]
    },
    "format": {
     "type": "string",
     "enum": [
      "jpeg",
      "png"
     ]
    },
    "quality": {
     "type": "integer",
     "minimum": 30,
     "maximum": 100
    }
   }
  },
  "annotations": {
   "readOnlyHint": true,
   "idempotentHint": true,
   "openWorldHint": false
  },
  "_meta": {
   "ui": {
    "resourceUri": "ui://after-effects/activity.html"
   }
  }
 },
 {
  "name": "render_in_background",
  "description": "Render a comp with aerender in a separate process (project is saved first). wait:true waits with per-frame progress. Details: ae://docs/render_in_background",
  "inputSchema": {
   "type": "object",
   "properties": {
    "preset": {
     "type": "string",
     "enum": [
      "mp4-h264-high",
      "prores-422",
      "prores-4444-alpha",
      "png-seq",
      "gif"
     ]
    },
    "wait": {
     "type": "boolean"
    },
    "waitSeconds": {
     "type": "integer",
     "minimum": 10,
     "maximum": 86400
    },
    "comp": {
     "type": "string"
    },
    "outputPath": {
     "type": "string"
    },
    "outputModuleTemplate": {
     "type": "string"
    },
    "renderSettingsTemplate": {
     "type": "string"
    },
    "startFrame": {
     "type": "integer"
    },
    "endFrame": {
     "type": "integer"
    }
   },
   "required": [
    "comp",
    "outputPath"
   ]
  },
  "annotations": {
   "readOnlyHint": false,
   "destructiveHint": false,
   "openWorldHint": false
  },
  "_meta": {
   "ui": {
    "resourceUri": "ui://after-effects/activity.html"
   }
  }
 },
 {
  "name": "undo",
  "description": "Undo or redo the last After Effects steps. Every MCP call is a single undo step; right after end_undo_group, undo without steps reverts the whole group.",
  "inputSchema": {
   "type": "object",
   "properties": {
    "action": {
     "type": "string",
     "enum": [
      "undo",
      "redo"
     ]
    },
    "steps": {
     "type": "integer",
     "minimum": 1,
     "maximum": 50
    }
   }
  },
  "annotations": {
   "readOnlyHint": false,
   "destructiveHint": false,
   "openWorldHint": false
  },
  "_meta": {
   "ui": {
    "resourceUri": "ui://after-effects/activity.html"
   }
  }
 },
 {
  "name": "batch",
  "description": "Run many AE tools in ONE call and ONE undo step, e.g. [{tool:'create_text_layer',args:{...}},{tool:'animate_layer',args:{...}}]. Fails with isError + partial results; atomic:true reverts all. Details: ae://docs/batch",
  "inputSchema": {
   "type": "object",
   "properties": {
    "operations": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "tool": {
        "type": "string"
       },
       "args": {
        "type": "object",
        "additionalProperties": {}
       }
      },
      "required": [
       "tool"
      ],
      "additionalProperties": false
     },
     "minItems": 1,
     "maxItems": 200
    },
    "continueOnError": {
     "type": "boolean"
    },
    "atomic": {
     "type": "boolean"
    },
    "verbose": {
     "type": "boolean"
    },
    "parkViewer": {
     "type": "boolean"
    }
   },
   "required": [
    "operations"
   ]
  },
  "annotations": {
   "readOnlyHint": false,
   "destructiveHint": false,
   "openWorldHint": false
  },
  "_meta": {
   "ui": {
    "resourceUri": "ui://after-effects/activity.html"
   }
  }
 }
]
