      "type": "number"
     },
     "minItems": 1,
     "maxItems": 3
    },
    "anchor": {
     "type": "string",
     "enum": [
      "center",
      "left",
      "right",
      "top",
      "bottom",
      "top-left",
      "top-right",
      "bottom-left",
      "bottom-right",
      "baseline-left",
      "baseline-center",
      "baseline-right",
      "origin"
     ]
    },
