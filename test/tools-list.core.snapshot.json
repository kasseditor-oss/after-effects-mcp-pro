       "type": "array",
       "items": {
        "type": "number"
       },
       "minItems": 3,
       "maxItems": 4
      }
     ]
    },
    "strokeColor": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "array",
       "items": {
        "type": "number"
       },
       "minItems": 3,
       "maxItems": 4
      }
     ]
    },
    "strokeWidth": {
     "type": "number"
    },
    "tracking": {
     "type": "number"
    },
    "leading": {
     "type": "number"
    },
    "justification": {
     "type": "string",
     "enum": [
      "left",
      "center",
      "right",
      "justify"
     ]
    },
    "caps": {
     "type": "string",
     "enum": [
      "normal",
      "all",
      "small",
      "all-small"
     ]
    },
