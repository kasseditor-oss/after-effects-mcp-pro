 {
  "name": "create_composition",
  "description": "Create a comp (preset 1080p|4k|vertical|square... or width/height). open:false is faster when you add many layers first. Details: ae://docs/create_composition",
  "inputSchema": {
   "type": "object",
   "properties": {
    "name": {
     "type": "string"
    },
    "preset": {
     "type": "string",
     "enum": [
      "hd",
      "1080p",
      "720p",
      "4k",
      "uhd",
      "2k",
      "vertical",
      "story",
      "reels",
      "tiktok",
      "shorts",
      "square",
      "instagram",
      "portrait-4x5",
      "youtube-thumbnail",
      "twitter"
     ]
    },
    "width": {
     "type": "integer",
     "minimum": 4,
     "maximum": 30000
    },
    "height": {
     "type": "integer",
     "minimum": 4,
     "maximum": 30000
    },
    "duration": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "frameRate": {
     "type": "number",
     "exclusiveMinimum": 0,
     "maximum": 999
    },
    "pixelAspect": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "backgroundColor": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "array",
       "items": {
        "type": "number"
       },
       "minItems": 3,
       "maxItems": 4
      }
     ]
    },
    "folder": {
     "type": "string"
    },
    "open": {
     "type": "boolean"
    }
   },
   "required": [
    "name"
   ]
  },
  "annotations": {
   "readOnlyHint": false,
   "destructiveHint": false,
   "openWorldHint": false
  },
  "_meta": {
   "ui": {
    "resourceUri": "ui://after-effects/activity.html"
   }
  }
 },
