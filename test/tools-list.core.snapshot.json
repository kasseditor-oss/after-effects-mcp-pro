 {
  "name": "create_shape_layer",
  "description": "Create a shape layer with one or many shapes (rectangle, ellipse, polygon, star, custom path), fill/stroke, rounded corners, Trim Paths and Repeater.",
  "inputSchema": {
   "type": "object",
   "properties": {
    "comp": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "integer"
      }
     ]
    },
    "shapes": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "type": {
        "type": "string",
        "enum": [
         "rectangle",
         "ellipse",
         "polygon",
         "star",
         "path"
        ],
        "default": "rectangle"
       },
       "name": {
        "type": "string"
       },
       "size": {
        "anyOf": [
         {
          "type": "number"
         },
         {
          "type": "array",
          "items": {
           "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
         }
        ]
       },
       "roundness": {
        "type": "number"
       },
       "points": {
        "type": "integer"
       },
       "vertices": {
        "type": "array",
        "items": {
         "type": "array",
         "items": {
          "type": "number"
         },
         "minItems": 2,
         "maxItems": 2
        }
       },
       "closed": {
        "type": "boolean"
       },
       "fill": {
        "anyOf": [
         {
          "anyOf": [
           {
            "type": "string"
           },
           {
            "type": "array",
            "items": {
             "type": "number"
            },
            "minItems": 3,
            "maxItems": 4
           }
          ]
         },
         {
          "type": "boolean",
          "const": false
         }
        ]
       },
       "stroke": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "type": "array",
          "items": {
           "type": "number"
          },
          "minItems": 3,
          "maxItems": 4
         }
        ]
       },
       "strokeWidth": {
        "type": "number"
       },
       "trimPaths": {
        "type": "object",
        "properties": {
         "start": {
          "type": "number"
         },
         "end": {
          "type": "number"
         },
         "offset": {
          "type": "number"
         }
        },
        "additionalProperties": false
       },
       "offset": {
        "type": "array",
        "items": {
         "type": "number"
        }
       }
      },
      "additionalProperties": false
     }
    },
    "name": {
     "type": "string"
    },
    "rotation": {
     "type": "number"
    },
    "position": {
     "type": "array",
     "items": {
      "type": "number"
     },
     "minItems": 1,
     "maxItems": 3
    },
    "anchor": {
     "type": "string",
     "enum": [
      "center",
      "left",
      "right",
      "top",
      "bottom",
      "top-left",
      "top-right",
      "bottom-left",
      "bottom-right",
      "baseline-left",
      "baseline-center",
      "baseline-right",
      "origin"
     ]
    },
    "scale": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "array",
       "items": {
        "type": "number"
       },
       "minItems": 1,
       "maxItems": 3
      }
     ]
    },
    "opacity": {
     "type": "number",
     "minimum": 0,
     "maximum": 100
    },
    "startTime": {
     "type": "number"
    },
    "duration": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "parent": {
     "type": [
      "number",
      "string"
     ]
    }
   }
  },
  "annotations": {
   "readOnlyHint": false,
   "destructiveHint": false,
   "openWorldHint": false
  },
  "_meta": {
   "ui": {
    "resourceUri": "ui://after-effects/activity.html"
   }
  }
